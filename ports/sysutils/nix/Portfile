# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                nix
version             2.33.0
categories          sysutils
platforms           {darwin >= 21}
supported_archs     arm64
license             LGPL-2.1
maintainers         {ada-yang.dev:git @ada-yang-dev} openmaintainer
description         Purely functional package manager
long_description    Self-healing Nix installation via official installer delegation.

homepage            https://nixos.org
master_sites        https://releases.nixos.org/nix/nix-${version}/
distname            nix-${version}-aarch64-darwin
checksums           sha256 cb24dfa5d8b2ff87492cd34082e51139f1f35970f04a8da3fb90e2e4894346ed
extract.suffix      .tar.xz

use_configure       no
build               {}

set share           ${prefix}/share/nix
set bin             ${prefix}/bin

destroot {
    xinstall -d ${destroot}${share}/installer ${destroot}${bin}
    system "cp -R ${workpath}/${distname}/* ${destroot}${share}/installer/"
    
    # Only `nix` is wrapped; block unwrapped entry points
    foreach cmd {nix-build nix-shell nix-env nix-store nix-instantiate nix-collect-garbage nix-channel} {
        set f [open ${destroot}${bin}/${cmd} w]
        puts ${f} "#!/bin/sh\necho 'Not available. Use: nix' >&2\nexit 1"
        close ${f}
        file attributes ${destroot}${bin}/${cmd} -permissions +x
    }
    
    # Wrapper: revive → gc → delegate
    set f [open ${destroot}${bin}/nix w]
    puts ${f} {#!/bin/sh
[ -x /nix/var/nix/profiles/default/bin/nix ] || { echo "Reviving..." >&2; cd /opt/local/share/nix/installer && sudo ./install --daemon --yes; }
m=/opt/local/share/nix/.gc; [ -f "$m" ] && [ $(($(date +%s) - $(stat -f %m "$m"))) -lt 86400 ] || { /nix/var/nix/profiles/default/bin/nix-collect-garbage --delete-older-than 1d >/dev/null 2>&1 ||:; touch "$m"; }
export NIX_CONFIG="experimental-features = nix-command flakes"
exec /nix/var/nix/profiles/default/bin/nix "$@"}
    close ${f}
    file attributes ${destroot}${bin}/nix -permissions +x
}

post-activate {
    system "cd ${share}/installer && ./install --daemon --yes ||:"
}

pre-deactivate {
    # Revive to uninstall: need working tools for clean cleanup
    system "[ -x /nix/nix-installer ] || { cd ${share}/installer && ./install --daemon --yes ||:; }"
    system "/nix/nix-installer uninstall --no-confirm ||:"
}

notes "Self-healing. Daily GC. Use nix command."
