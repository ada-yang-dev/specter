# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                nix
version             2.94.0
categories          sysutils
platforms           darwin
supported_archs     arm64
license             LGPL-2.1
maintainers         {ada-yang.dev:git @ada-yang-dev} openmaintainer
description         Nix package manager (Lix implementation)
long_description    Self-healing Nix installation via Lix installer delegation.

homepage            https://lix.systems
master_sites        https://install.lix.systems/
distname            lix
extract.suffix
checksums           sha256 2048ddb5af8e4cbcdee185a094e1433211eea257246223176c3594cfb1abd90f

extract             {}
use_configure       no
build               {}

set share           ${prefix}/share/nix
set bin             ${prefix}/bin

destroot {
    xinstall -d ${destroot}${share} ${destroot}${bin}
    xinstall -m 755 ${distpath}/${distname} ${destroot}${share}/install.sh
    
    # Only `nix` is wrapped; block unwrapped entry points
    foreach cmd {nix-build nix-shell nix-env nix-store nix-instantiate nix-collect-garbage nix-channel} {
        set f [open ${destroot}${bin}/${cmd} w]
        puts ${f} "#!/bin/sh\necho 'Not available. Use: nix' >&2\nexit 1"
        close ${f}
        file attributes ${destroot}${bin}/${cmd} -permissions +x
    }
    
    # Wrapper: gc → delegate (Lix survives macOS upgrades; if broken, reinstall via MacPorts)
    set f [open ${destroot}${bin}/nix w]
    set script {#!/bin/sh
m=@SHARE@/.gc; [ -f "$m" ] && [ $(($(date +%s) - $(stat -f %m "$m"))) -lt 86400 ] || { /nix/var/nix/profiles/default/bin/nix-collect-garbage --delete-older-than 1d >/dev/null 2>&1 ||:; touch "$m"; }
exec /nix/var/nix/profiles/default/bin/nix "$@"}
    puts ${f} [string map [list @SHARE@ ${share}] $script]
    close ${f}
    file attributes ${destroot}${bin}/nix -permissions +x
}

post-activate {
    ui_msg "Running Nix installer..."
    system "sh ${share}/install.sh -- install --no-confirm ||:"
}

pre-deactivate {
    system "/nix/lix-installer uninstall --no-confirm ||:"
}

notes "Self-healing. Daily GC. Flakes enabled by default."
