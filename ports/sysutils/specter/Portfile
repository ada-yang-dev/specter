# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                specter
version             0.0.1
categories          sysutils
platforms           darwin
supported_archs     arm64
license             CC-BY-NC-SA-4.0
maintainers         {ada-yang.dev:git @ada-yang-dev} openmaintainer

description         Authentic terminal primitives enabling autonomous agents \
                    to operate interactive applications.

long_description    Specter provides authentic terminal primitives for autonomous \
                    agents. The daemon multiplexes PTYs with stateful workspace \
                    ownership and full escape sequence passthrough. Agents read \
                    ANSI viewports and write control sequences directly, enabling \
                    operation of interactive applications including TUI programs, \
                    shells, and other agents.

homepage            https://github.com/ada-yang-dev/specter

fetch.type          none

depends_run         port:nix

use_configure       no
build               {}

set profile         /nix/var/nix/profiles/macports

destroot {
    xinstall -d ${destroot}${prefix}/bin
    ln -s ${profile}/bin/specter ${destroot}${prefix}/bin/specter
    ln -s ${profile}/bin/specterd ${destroot}${prefix}/bin/specterd
    ln -s ${profile}/bin/specterctl ${destroot}${prefix}/bin/specterctl
}

post-activate {
    system "nix profile install github:ada-yang-dev/specter --profile ${profile} --refresh"
}

pre-deactivate {
    system "nix profile remove '.*specter.*' --profile ${profile} ||:"
}

notes "specterd: /tmp/specter.sock"
